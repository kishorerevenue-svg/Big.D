# Copy this file to .env and fill in your values.

# Your Claude API key from https://console.anthropic.com  (keep it secret, never put it in the app)
ANTHROPIC_API_KEY=sk-ant-PUT-YOUR-KEY-HERE

# Which Claude model answers. Haiku is the fastest and cheapest.
ANTHROPIC_MODEL=claude-haiku-5-5

# Port the server listens on (Caddy forwards your domain to this port)
PORT=3000

# Save every chat to data/chats.jsonl? true or false.
# If you turn this on, say so in your privacy policy.
SAVE_CHATS=false

# How many messages one phone can send in 10 minutes (protects your API bill)
LIMIT_PER_10_MIN=40

# Where the app runs from. Leave as is for the Android app.
ALLOWED_ORIGINS=https://localhost,http://localhost,capacitor://localhost

# Let the puppy search the internet for news, prices, results etc. true or false.
# Each search costs extra ($10 per 1,000 searches) on top of normal usage.
WEB_SEARCH=true

# Password for the owner-only Teach page (https://yourdomain/teach).
# Leave empty to switch teaching off. Use a long password only you know.
TEACH_PASSWORD=

# Two-level brain. Normal chat uses ANTHROPIC_MODEL (fast, cheap).
# Hard or many-task requests use SMART_MODEL (smarter, costs a few times more).
SMART_MODEL=claude-sonnet-5-5
# auto = choose by itself, always = always smart, never = always fast
SMART_MODE=auto

# Daily limits (reset at midnight India time). They protect your API bill.
# Messages per phone per day, per internet address per day, and for all users together.
PER_DEVICE_DAILY=80
PER_IP_DAILY=250
DAILY_TOTAL=4000

# Natural voice (optional): Google Cloud Text-to-Speech API key (Chirp 3 HD voices, Telugu + English).
# Leave empty to use the phone's own voice. First 1 million characters each month are free.
GOOGLE_TTS_KEY=
# Optional: force one voice for all pets, e.g. te-IN-Chirp3-HD-Leda / en-IN-Chirp3-HD-Leda
TTS_VOICE_TE=
TTS_VOICE_EN=
TTS_PER_DEVICE_DAILY=300
TTS_DAILY_TOTAL=10000
# Bill guard: natural voice pauses after this many characters in a month (Google gives 1,000,000 free)
TTS_MONTHLY_CHARS=900000

# Community page: the BigD team password (type it in the app: Pet › Advanced › Team password)
# to reply to posts, pin them, and remove or restore reported posts. Empty = TEACH_PASSWORD is used.
ADMIN_PASSWORD=
# Message safety checks per phone per day, and for everyone together
SCAN_PER_DEVICE_DAILY=100
SCAN_DAILY_TOTAL=8000

# Media page: the AI writes Telugu posts with real links (news, movies, kids, crypto, real estate,
# jobs, devotional, farming, health). It fills each section with MEDIA_SEED posts, then adds new posts
# every morning after 6 AM. MEDIA_MAX_CALLS_DAY limits the AI calls per day (each call writes a few posts).
MEDIA_AUTO=true
MEDIA_SEED=12
MEDIA_MAX_CALLS_DAY=40
# All day: new stories from news feeds (Teach page › Media posts), written by our own brain. 2 = twice as many
# posts each time. If our own brain can't write (not installed, or the small 1B model), Claude writes up to
# FEED_CLAUDE_DAILY short posts a day instead.
MEDIA_FEEDS=true
MEDIA_FEED_MORE=1
FEED_CLAUDE_DAILY=40
# YouTube in Media: new videos of trusted Telugu channels, live TV and live darshan, Shorts (Teach page › YouTube).
# Works without a key. The free YouTube Data API key (Google Cloud › APIs › YouTube Data API v3 › Credentials)
# also brings the most popular Telugu videos of the day.
MEDIA_YOUTUBE=true
YOUTUBE_API_KEY=
# About 80 YouTube video posts a day (news 24, movies 20, devotional 10, kids 8, farming 6…); 2 = twice as many
YOUTUBE_MORE=1
# Short videos of Media posts (to share on WhatsApp status…): REELS_DAILY a day. With the free Pexels key
# (pexels.com/api › Your API key) each video gets 2 or 3 moving scenes that fit the story, credited to their makers.
REELS_DAILY=16
PEXELS_API_KEY=
# Daily AI videos (Gemini Omni; uses GEMINI_API_KEY with billing on): AI_VIDEOS_DAILY a day, never more than
# AI_VIDEO_MONTHLY_USD a month (the server counts and stops). Only safe, timeless topics, labelled "AI-made".
AI_VIDEOS=true
AI_VIDEOS_DAILY=2
AI_VIDEO_MONTHLY_USD=35
AI_VIDEO_SECONDS=8
# Mandi crop prices every afternoon (free key from data.gov.in: sign in › My account › API key). Empty = no prices.
DATA_GOV_KEY=
