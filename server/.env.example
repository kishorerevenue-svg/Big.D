# Copy this file to .env and fill in your values.

# Your Claude API key from https://console.anthropic.com  (keep it secret, never put it in the app)
ANTHROPIC_API_KEY=sk-ant-PUT-YOUR-KEY-HERE

# Which Claude model answers. Haiku is the fastest and cheapest.
ANTHROPIC_MODEL=claude-haiku-5-5

# Port the server listens on (Caddy forwards your domain to this port)
PORT=3000

# Save every chat to data/chats.jsonl? true or false.
# If you turn this on, say so in your privacy policy.
SAVE_CHATS=false

# How many messages one phone can send in 10 minutes (protects your API bill)
LIMIT_PER_10_MIN=40

# Where the app runs from. Leave as is for the Android app.
ALLOWED_ORIGINS=https://localhost,http://localhost,capacitor://localhost

# Let the puppy search the internet for news, prices, results etc. true or false.
# Each search costs extra ($10 per 1,000 searches) on top of normal usage.
WEB_SEARCH=true

# Password for the owner-only Teach page (https://yourdomain/teach).
# Leave empty to switch teaching off. Use a long password only you know.
TEACH_PASSWORD=

# Two-level brain. Normal chat uses ANTHROPIC_MODEL (fast, cheap).
# Hard or many-task requests use SMART_MODEL (smarter, costs a few times more).
SMART_MODEL=claude-sonnet-5-5
# auto = choose by itself, always = always smart, never = always fast
SMART_MODE=auto

# Daily limits (reset at midnight India time). They protect your API bill.
# Messages per phone per day, per internet address per day, and for all users together.
PER_DEVICE_DAILY=80
PER_IP_DAILY=250
DAILY_TOTAL=4000

# Natural voice (optional): Google Cloud Text-to-Speech API key (Chirp 3 HD voices, Telugu + English).
# Leave empty to use the phone's own voice. First 1 million characters each month are free.
GOOGLE_TTS_KEY=
# Optional: force one voice for all pets, e.g. te-IN-Chirp3-HD-Leda / en-IN-Chirp3-HD-Leda
TTS_VOICE_TE=
TTS_VOICE_EN=
TTS_PER_DEVICE_DAILY=300
TTS_DAILY_TOTAL=10000
